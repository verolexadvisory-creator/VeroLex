# ============================================================
# VeroLex Advisory — maxfiy sozlamalar namunasi
#
# 1) Ushbu faylni `.env` nomi bilan nusxalang.
# 2) Qiymatlarni toʻldiring.
# 3) Faylni sayt ildizidan BITTA YUQORIDAGI papkaga joylang
#    (masalan: /home/user/.env  — public_html ning yonida).
#    Agar bunday imkoniyat boʻlmasa, sayt ildizining oʻziga
#    qoʻying — .htaccess uni tashqi kirishdan yopadi.
# 4) Bu faylni hech kimga yubormang va git ga qoʻshmang.
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ixtiyoriy — murojaatlarni Google Sheets ga ham yozish uchun
GOOGLE_SHEET_WEBHOOK_URL=
